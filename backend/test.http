###
# CLASSES: Get all classes grouped by department and year
GET https://e-dispy.onrender.com/api/classes
Authorization: Bearer {{token}}

# Expected: 200 OK

###
# CLASSES: Create CSE Year 2 Section A
POST https://e-dispy.onrender.com/api/classes
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "department_id": 1,
  "year": 2,
  "section": "A",
  "room_number": "B201"
}

# Expected: 201 Created

###
# CLASSES: Update class room number (example uses id=1)
PUT https://e-dispy.onrender.com/api/classes/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "room_number": "B202"
}

# Expected: 200 OK

###
# CLASSES: Delete class id=1
DELETE https://e-dispy.onrender.com/api/classes/1
Authorization: Bearer {{token}}

# Expected: 200 OK / 204 No Content

###
# TIMETABLE: Get full weekly timetable for class id 1
GET https://e-dispy.onrender.com/api/timetable/1
Authorization: Bearer {{token}}
### Get timetable for class 2
GET https://e-dispy.onrender.com/api/timetable/2
Authorization: Bearer {{token}}
# Expected: 200 OK

###
# TIMETABLE: Save timetable slots for Monday for class id 1
POST https://e-dispy.onrender.com/api/timetable/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "day": "Monday",
  "slots": [
    { "period_number": 1, "slot_type": "lecture", "subject_id": 1, "faculty_id": 2 }
  ]
}

# Expected: 200 OK / 201 Created

###
# TIMETABLE: Get currently running period for class id 1
GET https://e-dispy.onrender.com/api/timetable/1/current-period
Authorization: Bearer {{token}}

# Expected: 200 OK

###
# TIMETABLE: Publish timetable to MQTT for class id 1
POST https://e-dispy.onrender.com/api/timetable/1/publish
Authorization: Bearer {{token}}

# Expected: 200 OK

###
# PERIOD TIMINGS: Get all period timings
GET https://e-dispy.onrender.com/api/period-timings
Authorization: Bearer {{token}}

# Expected: 200 OK

