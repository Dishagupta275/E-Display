###
# AUTH: Login with correct principal credentials (should return JWT token)
POST https://e-dispy.onrender.com/api/auth/login
Content-Type: application/json

{
  "email": "principal@edisplay.com",
  "password": "Principal@123"
}

# Expected: 200 OK
# {
#   "access_token": "<JWT>",
#   "user": { ... }
# }

###
# AUTH: Login with wrong password (should return 401)
POST https://e-dispy.onrender.com/api/auth/login
Content-Type: application/json

{
  "email": "principal@edisplay.com",
  "password": "wrongpassword"
}

# Expected: 401 Unauthorized

